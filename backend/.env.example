# RiskLoop Backend Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Session Secret (generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# =============================================================================
# INDIAN BROKERS
# =============================================================================

# Angel One (SmartAPI)
# Get credentials from: https://smartapi.angelone.in/
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# FYERS
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://localhost:3000/api/auth/fyers/callback

# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback

# Shoonya (Finvasia)
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=
SHOONYA_IMEI=

# Alice Blue
ALICEBLUE_USER_ID=
ALICEBLUE_API_KEY=

# Kotak Neo
KOTAKNEO_CONSUMER_KEY=
KOTAKNEO_CONSUMER_SECRET=
KOTAKNEO_ACCESS_TOKEN=
KOTAKNEO_ACCESS_SECRET=

# SAMCO
SAMCO_USER_ID=
SAMCO_PASSWORD=
SAMCO_YOTP=

# =============================================================================
# FOREX / MT5
# =============================================================================

# MetaTrader 5 (via MT5 API or broker-specific MT5 integration)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# =============================================================================
# LOGGING
# =============================================================================

# Log Level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log to file (true/false)
LOG_TO_FILE=false

# =============================================================================
# SECURITY
# =============================================================================

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Request timeout (milliseconds)
API_TIMEOUT=30000
